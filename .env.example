# SMTP usado pelas Ordens de Fornecimento e pelos lembretes ao fornecedor
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sistema LBCC <no-reply@example.com>
SMTP_REPLY_TO=contato@example.com

# URL publica autenticada da aplicacao; sem ela o e-mail nao inclui link
FRONTEND_URL=https://app.example.com

# Jobs podem ser desligados em ambientes que executam os workers separadamente
PROXIMIDADE_JOB_ENABLED=true
ATRASO_JOB_ENABLED=true
ATRASO_JOB_INTERVAL_MS=900000
LEMBRETES_FORNECEDOR_JOB_ENABLED=true
LEMBRETES_FORNECEDOR_JOB_INTERVAL_MS=60000
ORDENS_FORNECIMENTO_EMAIL_JOB_ENABLED=true
ORDENS_FORNECIMENTO_EMAIL_JOB_INTERVAL_MS=60000
AUTOMACAO_LEASE_TTL_MS=600000
